      "actions": [
        {
          "name": "send_to_agent",
          "description": "Send a message to an existing OpenCode session or start a new session in a directory. chat_id may identify a session by its ID, nickname, or unambiguous title; use \"new\" to start a session in the configured directory. Omit chat_id to follow settings: use the configured default session or start a new one. The optional delivery parameter queues the message until the current run finishes or steers it into the active run; omit it to use the plugin default. Returns a receipt for the requested delivery mode, not OpenCode's reply. Do not automatically retry uncertain delivery or conflicts.",
          "parameters": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000,
                "description": "Message to send to OpenCode."
              },
              "chat_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Session ID, nickname, or unambiguous title. Use \"new\" to start a session in the configured directory; omit to follow settings."
              },
              "delivery": {
                "type": "string",
                "enum": [
                  "queue",
                  "steer"
                ],
                "description": "queue waits for the current run; steer injects at the next safe turn. Omit to use the plugin setting; initial default queue."
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          },
          "targets": [
            "agent/chats"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        },
        {
          "name": "interrupt_session",
          "description": "Stop foreground execution in the explicitly identified OpenCode session. The virtual new target is invalid; detached jobs are not cancelled. Do not automatically retry when the result is uncertain.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^ses[A-Za-z0-9_-]{1,160}$",
                "description": "Explicit OpenCode session ID to interrupt."
              }
            },
            "required": [
              "session_id"
            ],
            "additionalProperties": false
          },
          "targets": [
            "opencode/active_session",
            "agent/chats",
            "opencode/reply",
            "opencode/replies"
          ],
          "destructive": true,
          "requiresConfirmation": true,
          "callerPermissions": []
        },
        {
          "name": "answer_question",
          "description": "Submit explicit choices for the identified OpenCode question after checking its actual fields. This is not permission approval; external desktop-only questions cannot be answered. Do not automatically retry when the result is uncertain.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^ses[A-Za-z0-9_-]{1,160}$",
                "description": "Explicit OpenCode session ID that owns the question."
              },
              "form_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Form ID returned by opencode/question."
              },
              "answer": {
                "type": "object",
                "maxProperties": 50,
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "description": "Explicit field-value record, bounded to 16000 JSON characters at runtime."
              }
            },
            "required": [
              "session_id",
              "form_id",
              "answer"
            ],
            "additionalProperties": false
          },
          "targets": [
            "opencode/question",
            "opencode/chat_status"
          ],
          "destructive": false,
          "requiresConfirmation": true,
          "callerPermissions": []
        },
        {
          "name": "approve_permission",
          "description": "Approve once or reject the identified OpenCode permission request after checking its operation. Permanent approval is not offered. Do not automatically retry when the result is uncertain.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^ses[A-Za-z0-9_-]{1,160}$",
                "description": "Explicit OpenCode session ID that owns the permission request."
              },
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Permission request ID returned by opencode/permission."
              },
              "decision": {
                "type": "string",
                "enum": [
                  "once",
                  "reject"
                ],
                "default": "once",
                "description": "Approve this request once or reject it."
              },
              "message": {
                "type": "string",
                "maxLength": 2000,
                "description": "Optional explanation sent with the response."
              }
            },
            "required": [
              "session_id",
              "request_id"
            ],
            "additionalProperties": false
          },
          "targets": [
            "opencode/permission",
            "opencode/chat_status",
            "opencode/active_session",
            "opencode/activity"
          ],
          "destructive": true,
          "requiresConfirmation": true,
          "callerPermissions": []
        },
        {
          "name": "mark_chat_read",
          "description": "Clear the watch-local unread marker for a chat. Pass the message ID that was read, or omit it to mark the latest reply read. This does not change desktop read state.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^ses[A-Za-z0-9_-]{1,160}$",
                "description": "Explicit OpenCode session ID to mark read."
              },
              "message_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Message ID that was read. Omit to mark the latest reply read."
              }
            },
            "required": [
              "session_id"
            ],
            "additionalProperties": false
          },
          "targets": [
            "opencode/chat_status"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        },
        {
          "name": "cancel_queued_message",
          "description": "Cancel a specific pending inbox message after revalidating it against its live session. This permanently removes the queued item. Do not retry uncertain outcomes.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^ses[A-Za-z0-9_-]{1,160}$"
              },
              "inbox_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "session_id",
              "inbox_id"
            ],
            "additionalProperties": false
          },
          "targets": [
            "opencode/queue"
          ],
          "destructive": true,
          "requiresConfirmation": true,
          "callerPermissions": []
        },
        {
          "name": "set_queued_delivery",
          "description": "Change delivery mode of a specific pending inbox message after live revalidation. Steering wakes execution and changes the active run. Do not retry uncertain outcomes.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^ses[A-Za-z0-9_-]{1,160}$"
              },
              "inbox_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "delivery": {
                "type": "string",
                "enum": [
                  "queue",
                  "steer"
                ]
              }
            },
            "required": [
              "session_id",
              "inbox_id",
              "delivery"
            ],
            "additionalProperties": false
          },
          "targets": [
            "opencode/queue"
          ],
          "destructive": true,
          "requiresConfirmation": true,
          "callerPermissions": []
        },
        {
          "name": "stop_shell",
          "description": "Stop a currently running OpenCode shell by exact shell ID and owning absolute server directory. Revalidates live state before stopping; retained output is deleted. Do not retry uncertain outcomes.",
          "parameters": {
            "type": "object",
            "properties": {
              "shell_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "directory": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Absolute server path; validated by the runtime."
              }
            },
            "required": [
              "shell_id",
              "directory"
            ],
            "additionalProperties": false
          },
          "targets": [
            "opencode/shell"
          ],
          "destructive": true,
          "requiresConfirmation": true,
          "callerPermissions": []
        },
        {
          "name": "run_command",
          "description": "Invoke an exact registered OpenCode command in an explicit live unarchived session. Rediscover the command at its location before execution. This action exposes registered command invocation, not arbitrary shell invocation; the command may itself use tools or run shell commands under OpenCode's configured permissions. Do not retry uncertain outcomes.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^ses[A-Za-z0-9_-]{1,160}$"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "text": {
                "type": "string",
                "maxLength": 16000
              },
              "delivery": {
                "type": "string",
                "enum": [
                  "queue",
                  "steer"
                ]
              }
            },
            "required": [
              "session_id",
              "command"
            ],
            "additionalProperties": false
          },
          "targets": [
            "opencode/command",
            "agent/chats",
            "opencode/reply",
            "opencode/replies"
          ],
          "destructive": true,
          "requiresConfirmation": true,
          "callerPermissions": []
        }
      ]
    },
    "configPage": "src/config.html"
  },
  "repository": "https://github.com/SeeSharpSi/pebble-oc-status"
}
