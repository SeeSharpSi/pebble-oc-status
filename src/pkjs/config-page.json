{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <title>OpenCode Status Settings</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      font: 15px/1.55 system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      --background: #f5f2ec;\n      --panel: #fffefa;\n      --text: #252a35;\n      --muted: #5f6878;\n      --border: #dedbd3;\n      --accent: #435bd5;\n      --accent-text: #ffffff;\n      --shadow: rgba(37, 42, 53, 0.08);\n      --wash: #f0eee8;\n      --focus: #6d7ff0;\n    }\n    @media (prefers-color-scheme: dark) {\n      :root {\n        --background: #171a22;\n        --panel: #222631;\n        --text: #f0f1f6;\n        --muted: #b5bac8;\n        --border: #414653;\n        --accent: #a7b4ff;\n        --accent-text: #08111c;\n        --shadow: rgba(0, 0, 0, 0.24);\n        --wash: #2a2f3b;\n        --focus: #a7b4ff;\n      }\n    }\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      background: var(--background);\n      color: var(--text);\n    }\n    main {\n      max-width: 800px;\n      margin: 0 auto;\n      padding: clamp(16px, 4vw, 42px);\n    }\n    header {\n      padding: 4px 2px 8px;\n      margin-bottom: 18px;\n    }\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      margin-bottom: 12px;\n    }\n    .mark {\n      display: grid;\n      width: 42px;\n      height: 42px;\n      flex: none;\n      place-items: center;\n      border-radius: 14px;\n      background: #435bd5;\n      box-shadow: 0 5px 14px #303e8b30;\n    }\n    .mark svg { width: 26px; height: 26px; }\n    h1 {\n      margin: 0;\n      font-size: clamp(1.55rem, 4vw, 1.9rem);\n      line-height: 1.2;\n      letter-spacing: -.035em;\n    }\n    p { margin: 5px 0 14px; }\n    .lede, .hint { color: var(--muted); font-size: .9rem; }\n    header > .lede { max-width: 62ch; margin: 0; }\n    section {\n      margin: 14px 0 0;\n      padding: clamp(17px, 3vw, 23px);\n      background: var(--panel);\n      border: 1px solid var(--border);\n      border-radius: 15px;\n      box-shadow: 0 3px 12px var(--shadow);\n    }\n    h2 {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin: 0 0 8px;\n      font-size: 1.12rem;\n      line-height: 1.3;\n      letter-spacing: -.015em;\n    }\n    h2::before { width: 4px; height: 1.15em; flex:none; border-radius: 8px; background: var(--accent); content: \"\"; }\n    .hint { margin: 0 0 14px; }\n    .subagents-warning { margin-top: 12px; }\n    .choices {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 10px;\n    }\n    label.choice {\n      display: flex;\n      gap: 11px;\n      align-items: flex-start;\n      min-height: 64px;\n      padding: 13px 14px;\n      border: 1px solid var(--border);\n      border-radius: 11px;\n      background: color-mix(in srgb, var(--wash) 35%, var(--panel));\n      cursor: pointer;\n      -webkit-tap-highlight-color: transparent;\n      touch-action: manipulation;\n    }\n    label.choice:has(input:checked) {\n      border-color: var(--accent);\n      background: color-mix(in srgb, var(--accent) 9%, var(--panel));\n      box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent);\n    }\n    label.choice:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }\n    label.choice:focus-within { outline: 3px solid color-mix(in srgb, var(--focus) 48%, transparent); outline-offset: 2px; }\n    input[type=\"radio\"], input[type=\"checkbox\"] {\n      margin: 3px 0 0;\n      width: 19px;\n      height: 19px;\n      accent-color: var(--accent);\n      flex: none;\n    }\n    .choice span { display: block; min-width: 0; }\n    .choice strong { display: block; font-size: 15px; font-weight: 620; line-height: 1.3; }\n    .choice small { display: block; margin-top: 3px; color: var(--muted); font-size: .84rem; line-height: 1.4; }\n    .toggle-row {\n      display: flex;\n      gap: 11px;\n      align-items: flex-start;\n      min-height: 64px;\n      padding: 13px 14px;\n      border: 1px solid var(--border);\n      border-radius: 11px;\n      background: color-mix(in srgb, var(--wash) 35%, var(--panel));\n      -webkit-tap-highlight-color: transparent;\n      touch-action: manipulation;\n    }\n    .toggle-row label {\n      flex: 1;\n      cursor: pointer;\n      line-height: 1.4;\n    }\n    textarea {\n      width: 100%;\n      min-height: 118px;\n      padding: 12px 14px;\n      border: 1px solid var(--border);\n      border-radius: 11px;\n      background: var(--panel);\n      color: var(--text);\n      font: 15px/1.45 ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace;\n      resize: vertical;\n    }\n    textarea:focus-visible { outline: 3px solid color-mix(in srgb, var(--focus) 55%, transparent); outline-offset: 2px; }\n    button {\n      width: 100%;\n      min-height: 46px;\n      margin-top: 20px;\n      padding: 12px 16px;\n      border: 0;\n      border-radius: 10px;\n      background: var(--accent);\n      color: var(--accent-text);\n      font: inherit;\n      font-size: .95rem;\n      font-weight: 650;\n      cursor: pointer;\n      -webkit-tap-highlight-color: transparent;\n    }\n    button:focus-visible { outline: 3px solid color-mix(in srgb, var(--focus) 65%, transparent); outline-offset: 3px; }\n    button:active { filter: brightness(.94); transform: scale(.99); }\n    footer {\n      margin-top: 14px;\n      color: var(--muted);\n      font-size: .8rem;\n      text-align: center;\n    }\n    @media(max-width:620px) {\n      main { padding: 16px 13px 26px; }\n      .choices { grid-template-columns: minmax(0, 1fr); gap: 8px; }\n      label.choice, .toggle-row { min-height: 58px; padding: 12px 13px; }\n      section { border-radius: 13px; }\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <div class=\"brand\"><span class=\"mark\" aria-hidden=\"true\"><svg viewBox=\"0 0 32 32\" fill=\"none\"><path d=\"M21.7 6.7a11 11 0 1 0 4.1 12.8\" stroke=\"white\" stroke-width=\"3.2\" stroke-linecap=\"round\"/><path d=\"M17.6 6.3h7.1v7.1\" stroke=\"white\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"13.4\" cy=\"16\" r=\"2.1\" fill=\"white\"/></svg></span><h1>OpenCode Status</h1></div>\n      <p class=\"lede\">Settings for the Pebble watchapp. Save, then open the app on the watch.</p>\n    </header>\n\n    <section aria-labelledby=\"polling-title\">\n      <h2 id=\"polling-title\">Plugin polling</h2>\n      <p class=\"hint\">Plugin default uses the OpenCode plugin's own refresh intervals.</p>\n      <div class=\"choices\">\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"poll_rate\" value=\"0\">\n          <span>\n            <strong>Plugin default</strong>\n            <small>Let the plugin decide when to refresh.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"poll_rate\" value=\"10\">\n          <span>\n            <strong>Every 10 seconds</strong>\n            <small>Fastest updates; uses more phone and network activity.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"poll_rate\" value=\"30\">\n          <span>\n            <strong>Every 30 seconds</strong>\n            <small>Balanced refresh rate.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"poll_rate\" value=\"60\">\n          <span>\n            <strong>Every 60 seconds</strong>\n            <small>Lowest activity.</small>\n          </span>\n        </label>\n      </div>\n    </section>\n\n    <section aria-labelledby=\"filter-title\">\n      <h2 id=\"filter-title\">Show only active/action</h2>\n      <p class=\"hint\">Hides read or idle sessions. Running sessions, unread replies, questions, and permission requests stay visible.</p>\n      <div class=\"toggle-row\">\n        <label for=\"only_action\">\n          <strong>Only show active or action-needed sessions</strong>\n        </label>\n        <input id=\"only_action\" type=\"checkbox\">\n      </div>\n    </section>\n\n    <section aria-labelledby=\"markread-title\">\n      <h2 id=\"markread-title\">Mark read after</h2>\n      <p class=\"hint\">On app load, unread replies older than this are marked read automatically. Permission and question requests are never dismissed.</p>\n      <div class=\"choices\">\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"0\">\n          <span>\n            <strong>Never</strong>\n            <small>Leave unread dots alone until you clear them.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"300\">\n          <span>\n            <strong>5 minutes</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"900\">\n          <span>\n            <strong>15 minutes</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"1800\">\n          <span>\n            <strong>30 minutes</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"3600\">\n          <span>\n            <strong>1 hour</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"7200\">\n          <span>\n            <strong>2 hours</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"86400\">\n          <span>\n            <strong>1 day</strong>\n          </span>\n        </label>\n      </div>\n    </section>\n\n    <section aria-labelledby=\"subagents-title\">\n      <h2 id=\"subagents-title\">Subagents</h2>\n      <p class=\"hint\">Choose how subagents appear in the watch list.</p>\n      <div class=\"choices\">\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"subagents\" value=\"show\">\n          <span>\n            <strong>Show</strong>\n            <small>Show subagents as separate rows.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"subagents\" value=\"number\">\n          <span>\n            <strong>Number</strong>\n            <small>Hide child rows and count active descendants beside the parent indicator.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"subagents\" value=\"hide\">\n          <span>\n            <strong>Hide</strong>\n            <small>Hide child rows and counts.</small>\n          </span>\n        </label>\n      </div>\n      <p class=\"hint subagents-warning\">Number and Hide also hide subagent questions and permission requests from the watch list. They are not forwarded to the parent session. Open OpenCode on your phone or computer to respond.</p>\n      <p class=\"hint\">Number requires an updated OpenCode plugin that exposes parent and root session IDs.</p>\n    </section>\n\n    <section aria-labelledby=\"canned-title\">\n      <h2 id=\"canned-title\">Canned replies</h2>\n      <p class=\"hint\">One per line, up to 8. Short-press Select on a reply to choose one; long-press to dictate.</p>\n      <textarea id=\"canned_replies\" spellcheck=\"true\" placeholder=\"Continue&#10;Yes&#10;No\">__OC_CANNED_REPLIES__</textarea>\n    </section>\n\n    <button id=\"save\" type=\"button\">Save settings</button>\n    <footer>OpenCode Status settings</footer>\n  </main>\n\n  <script>\n    (function () {\n      'use strict';\n\n      function optionParam(name, fallback) {\n        var source = location.hash.replace(/^#/, '');\n        if (!source) source = location.search.replace(/^\\?/, '');\n        var pairs = source.split('&');\n        for (var i = 0; i < pairs.length; i += 1) {\n          var pair = pairs[i].split('=');\n          if (decodeURIComponent(pair[0]) === name) {\n            return decodeURIComponent((pair[1] || '').replace(/\\+/g, ' '));\n          }\n        }\n        return fallback;\n      }\n\n      var returnTo = optionParam('return_to', 'pebblejs://close#');\n      if (returnTo.indexOf('#') === -1) returnTo += '#';\n\n      var injectedRate = Number('__OC_POLL_RATE__');\n      var injectedOnly = '__OC_ONLY_ACTION__';\n      var injectedMarkRead = Number('__OC_MARK_READ_AFTER__');\n      var injectedSubagents = '__OC_SUBAGENTS__';\n      var rate = isFinite(injectedRate) ? injectedRate : Number(optionParam('poll_rate', '0'));\n      var onlyAction = injectedOnly === '1' ? true :\n                       injectedOnly === '0' ? false :\n                       optionParam('only_action', '0') === '1';\n      var markReadAfter = isFinite(injectedMarkRead) ? injectedMarkRead :\n                          Number(optionParam('mark_read_after', '0'));\n      function validSubagents(value) {\n        return value === 'show' || value === 'number' || value === 'hide';\n      }\n      var subagents = 'show';\n      if (injectedSubagents === '__OC_' + 'SUBAGENTS__') {\n        var fallbackSubagents = optionParam('subagents', 'show');\n        if (validSubagents(fallbackSubagents)) subagents = fallbackSubagents;\n      } else if (validSubagents(injectedSubagents)) {\n        subagents = injectedSubagents;\n      }\n      var radios = document.querySelectorAll('input[name=\"poll_rate\"]');\n      var markRadios = document.querySelectorAll('input[name=\"mark_read_after\"]');\n      var subagentRadios = document.querySelectorAll('input[name=\"subagents\"]');\n      var checkbox = document.getElementById('only_action');\n      var canned = document.getElementById('canned_replies');\n      var hasRate = false;\n      var hasMarkRead = false;\n\n      Array.prototype.forEach.call(radios, function (radio) {\n        if (Number(radio.value) === rate) {\n          radio.checked = true;\n          hasRate = true;\n        }\n      });\n      if (!hasRate) radios[0].checked = true;\n      Array.prototype.forEach.call(markRadios, function (radio) {\n        if (Number(radio.value) === markReadAfter) {\n          radio.checked = true;\n          hasMarkRead = true;\n        }\n      });\n      if (!hasMarkRead) markRadios[0].checked = true;\n      var hasSubagents = false;\n      Array.prototype.forEach.call(subagentRadios, function (radio) {\n        if (radio.value === subagents) {\n          radio.checked = true;\n          hasSubagents = true;\n        }\n      });\n      if (!hasSubagents) subagentRadios[0].checked = true;\n      checkbox.checked = onlyAction;\n\n      document.getElementById('save').addEventListener('click', function () {\n        var selected = document.querySelector('input[name=\"poll_rate\"]:checked');\n        var selectedMarkRead = document.querySelector('input[name=\"mark_read_after\"]:checked');\n        var selectedSubagents = document.querySelector('input[name=\"subagents\"]:checked');\n        var options = {\n          poll_rate: selected ? Number(selected.value) : 0,\n          only_action: checkbox.checked ? 1 : 0,\n          mark_read_after: selectedMarkRead ? Number(selectedMarkRead.value) : 0,\n          subagents: selectedSubagents ? selectedSubagents.value : 'show',\n          canned_replies: canned.value.split(/\\r?\\n/)\n        };\n        document.location = returnTo + encodeURIComponent(JSON.stringify(options));\n      });\n    })();\n  </script>\n</body>\n</html>\n"}
