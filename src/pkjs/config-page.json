{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <title>OpenCode Status Settings</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --background: #f4f5f7;\n      --panel: #ffffff;\n      --text: #17191c;\n      --muted: #5f6670;\n      --border: #d8dce2;\n      --accent: #145da0;\n      --accent-text: #ffffff;\n      --shadow: rgba(20, 30, 45, 0.12);\n    }\n    @media (prefers-color-scheme: dark) {\n      :root {\n        --background: #16181c;\n        --panel: #23272e;\n        --text: #f2f4f7;\n        --muted: #aab1bb;\n        --border: #3a4049;\n        --accent: #4c9be8;\n        --accent-text: #08111c;\n        --shadow: rgba(0, 0, 0, 0.35);\n      }\n    }\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      background: var(--background);\n      color: var(--text);\n      font: 16px/1.45 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    }\n    main {\n      max-width: 620px;\n      margin: 0 auto;\n      padding: 20px 14px 32px;\n    }\n    header {\n      padding: 4px 2px 18px;\n    }\n    h1 {\n      margin: 0 0 6px;\n      font-size: 24px;\n      line-height: 1.15;\n      letter-spacing: -0.02em;\n    }\n    header p {\n      margin: 0;\n      color: var(--muted);\n      font-size: 14px;\n    }\n    section {\n      margin: 0 0 14px;\n      padding: 18px;\n      background: var(--panel);\n      border: 1px solid var(--border);\n      border-radius: 14px;\n      box-shadow: 0 1px 2px var(--shadow);\n    }\n    h2 {\n      margin: 0 0 4px;\n      font-size: 17px;\n      line-height: 1.25;\n    }\n    .hint {\n      margin: 0 0 14px;\n      color: var(--muted);\n      font-size: 14px;\n    }\n    .choices {\n      display: grid;\n      gap: 8px;\n    }\n    label.choice {\n      display: flex;\n      gap: 10px;\n      align-items: flex-start;\n      padding: 11px 12px;\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      cursor: pointer;\n      -webkit-tap-highlight-color: transparent;\n    }\n    label.choice:has(input:checked) {\n      border-color: var(--accent);\n      background: color-mix(in srgb, var(--accent) 9%, var(--panel));\n    }\n    input[type=\"radio\"], input[type=\"checkbox\"] {\n      margin: 3px 0 0;\n      width: 18px;\n      height: 18px;\n      accent-color: var(--accent);\n      flex: none;\n    }\n    .choice span {\n      display: block;\n    }\n    .choice strong {\n      display: block;\n      font-size: 15px;\n      line-height: 1.3;\n    }\n    .choice small {\n      display: block;\n      margin-top: 2px;\n      color: var(--muted);\n      font-size: 13px;\n      line-height: 1.35;\n    }\n    .toggle-row {\n      display: flex;\n      gap: 12px;\n      align-items: flex-start;\n      padding: 4px 0 0;\n    }\n    .toggle-row label {\n      flex: 1;\n      cursor: pointer;\n    }\n    textarea {\n      width: 100%;\n      min-height: 128px;\n      padding: 11px 12px;\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      background: var(--panel);\n      color: var(--text);\n      font: 15px/1.4 ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace;\n      resize: vertical;\n    }\n    button {\n      width: 100%;\n      margin-top: 20px;\n      padding: 14px 16px;\n      border: 0;\n      border-radius: 12px;\n      background: var(--accent);\n      color: var(--accent-text);\n      font: inherit;\n      font-weight: 650;\n      cursor: pointer;\n      -webkit-tap-highlight-color: transparent;\n    }\n    button:active {\n      filter: brightness(0.94);\n    }\n    footer {\n      margin-top: 14px;\n      color: var(--muted);\n      font-size: 12px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>OpenCode Status</h1>\n      <p>Settings for the Pebble watchapp. Save, then open the app on the watch.</p>\n    </header>\n\n    <section aria-labelledby=\"polling-title\">\n      <h2 id=\"polling-title\">Plugin polling</h2>\n      <p class=\"hint\">Plugin default uses the OpenCode plugin's own refresh intervals.</p>\n      <div class=\"choices\">\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"poll_rate\" value=\"0\">\n          <span>\n            <strong>Plugin default</strong>\n            <small>Let the plugin decide when to refresh.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"poll_rate\" value=\"10\">\n          <span>\n            <strong>Every 10 seconds</strong>\n            <small>Fastest updates; uses more phone and network activity.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"poll_rate\" value=\"30\">\n          <span>\n            <strong>Every 30 seconds</strong>\n            <small>Balanced refresh rate.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"poll_rate\" value=\"60\">\n          <span>\n            <strong>Every 60 seconds</strong>\n            <small>Lowest activity.</small>\n          </span>\n        </label>\n      </div>\n    </section>\n\n    <section aria-labelledby=\"filter-title\">\n      <h2 id=\"filter-title\">Show only active/action</h2>\n      <p class=\"hint\">Hides read or idle sessions. Running sessions, unread replies, questions, and permission requests stay visible.</p>\n      <div class=\"toggle-row\">\n        <label for=\"only_action\">\n          <strong>Only show active or action-needed sessions</strong>\n        </label>\n        <input id=\"only_action\" type=\"checkbox\">\n      </div>\n    </section>\n\n    <section aria-labelledby=\"markread-title\">\n      <h2 id=\"markread-title\">Mark read after</h2>\n      <p class=\"hint\">On app load, unread replies older than this are marked read automatically. Permission and question requests are never dismissed.</p>\n      <div class=\"choices\">\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"0\">\n          <span>\n            <strong>Never</strong>\n            <small>Leave unread dots alone until you clear them.</small>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"300\">\n          <span>\n            <strong>5 minutes</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"900\">\n          <span>\n            <strong>15 minutes</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"1800\">\n          <span>\n            <strong>30 minutes</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"3600\">\n          <span>\n            <strong>1 hour</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"7200\">\n          <span>\n            <strong>2 hours</strong>\n          </span>\n        </label>\n        <label class=\"choice\">\n          <input type=\"radio\" name=\"mark_read_after\" value=\"86400\">\n          <span>\n            <strong>1 day</strong>\n          </span>\n        </label>\n      </div>\n    </section>\n\n    <section aria-labelledby=\"canned-title\">\n      <h2 id=\"canned-title\">Canned replies</h2>\n      <p class=\"hint\">One per line, up to 8. Short-press Select on a reply to choose one; long-press to dictate.</p>\n      <textarea id=\"canned_replies\" spellcheck=\"true\" placeholder=\"Continue&#10;Yes&#10;No\">__OC_CANNED_REPLIES__</textarea>\n    </section>\n\n    <button id=\"save\" type=\"button\">Save settings</button>\n    <footer>OpenCode Status settings</footer>\n  </main>\n\n  <script>\n    (function () {\n      'use strict';\n\n      function optionParam(name, fallback) {\n        var source = location.hash.replace(/^#/, '');\n        if (!source) source = location.search.replace(/^\\?/, '');\n        var pairs = source.split('&');\n        for (var i = 0; i < pairs.length; i += 1) {\n          var pair = pairs[i].split('=');\n          if (decodeURIComponent(pair[0]) === name) {\n            return decodeURIComponent((pair[1] || '').replace(/\\+/g, ' '));\n          }\n        }\n        return fallback;\n      }\n\n      var returnTo = optionParam('return_to', 'pebblejs://close#');\n      if (returnTo.indexOf('#') === -1) returnTo += '#';\n\n      var injectedRate = Number('__OC_POLL_RATE__');\n      var injectedOnly = '__OC_ONLY_ACTION__';\n      var injectedMarkRead = Number('__OC_MARK_READ_AFTER__');\n      var rate = isFinite(injectedRate) ? injectedRate : Number(optionParam('poll_rate', '0'));\n      var onlyAction = injectedOnly === '1' ? true :\n                       injectedOnly === '0' ? false :\n                       optionParam('only_action', '0') === '1';\n      var markReadAfter = isFinite(injectedMarkRead) ? injectedMarkRead :\n                          Number(optionParam('mark_read_after', '0'));\n      var radios = document.querySelectorAll('input[name=\"poll_rate\"]');\n      var markRadios = document.querySelectorAll('input[name=\"mark_read_after\"]');\n      var checkbox = document.getElementById('only_action');\n      var canned = document.getElementById('canned_replies');\n      var hasRate = false;\n      var hasMarkRead = false;\n\n      Array.prototype.forEach.call(radios, function (radio) {\n        if (Number(radio.value) === rate) {\n          radio.checked = true;\n          hasRate = true;\n        }\n      });\n      if (!hasRate) radios[0].checked = true;\n      Array.prototype.forEach.call(markRadios, function (radio) {\n        if (Number(radio.value) === markReadAfter) {\n          radio.checked = true;\n          hasMarkRead = true;\n        }\n      });\n      if (!hasMarkRead) markRadios[0].checked = true;\n      checkbox.checked = onlyAction;\n\n      document.getElementById('save').addEventListener('click', function () {\n        var selected = document.querySelector('input[name=\"poll_rate\"]:checked');\n        var selectedMarkRead = document.querySelector('input[name=\"mark_read_after\"]:checked');\n        var options = {\n          poll_rate: selected ? Number(selected.value) : 0,\n          only_action: checkbox.checked ? 1 : 0,\n          mark_read_after: selectedMarkRead ? Number(selectedMarkRead.value) : 0,\n          canned_replies: canned.value.split(/\\r?\\n/)\n        };\n        document.location = returnTo + encodeURIComponent(JSON.stringify(options));\n      });\n    })();\n  </script>\n</body>\n</html>\n"}
